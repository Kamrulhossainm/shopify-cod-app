{%- comment -%}
  App embed: loads the COD form on product and cart pages.
  Enable in Online Store > Themes > Customize > App embeds.
{%- endcomment -%}
<div
  id="cod-app-root"
  hidden
  data-proxy="/apps/cod"
  data-page="{{ request.page_type }}"
  data-locale="{{ request.locale.iso_code }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-country="{{ localization.country.iso_code }}"
  {% if request.page_type == 'product' and product %}data-product-id="{{ product.id }}"{% endif %}
></div>
<script type="application/json" id="cod-money-format">{{ shop.money_format | strip_html | json }}</script>
{%- if request.page_type == 'product' and product -%}
  <script type="application/json" id="cod-product-json">
    {
      "id": {{ product.id }},
      "title": {{ product.title | json }},
      "handle": {{ product.handle | json }},
      "image": {{ product.featured_image | image_url: width: 200 | json }},
      "selected": {{ product.selected_or_first_available_variant.id }},
      "variants": [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id }},
            "title": {{ v.title | json }},
            "price": {{ v.price }},
            "available": {{ v.available }},
            "image": {% if v.featured_image %}{{ v.featured_image | image_url: width: 200 | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
<style>
  :root {
    --cod-btn-bg: {{ block.settings.fallback_button_color }};
  }
</style>

{% schema %}
{
  "name": "COD Order Form",
  "target": "body",
  "javascript": "cod-form.js",
  "stylesheet": "cod-form.css",
  "settings": [
    {
      "type": "paragraph",
      "content": "Design, fields, offers, upsells and pixels are configured inside the app admin."
    },
    {
      "type": "color",
      "id": "fallback_button_color",
      "label": "Fallback button color",
      "default": "#111827"
    }
  ]
}
{% endschema %}
